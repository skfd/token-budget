{
    "type": "AdaptiveCard",
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.5",
    "body": [
        {
            "type": "ColumnSet",
            "spacing": "small",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "Current session",
                            "weight": "bolder",
                            "size": "default",
                            "isSubtle": false
                        }
                    ]
                },
                {
                    "type": "Column",
                    "width": "auto",
                    "verticalContentAlignment": "bottom",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "${resetTime}",
                            "size": "small",
                            "isSubtle": true
                        }
                    ]
                }
            ]
        },
        {
            "type": "ColumnSet",
            "spacing": "small",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "verticalContentAlignment": "center",
                    "items": [
                        {
                            "type": "ColumnSet",
                            "$when": "${barStyle == 'accent'}",
                            "spacing": "none",
                            "columns": [
                                {
                                    "type": "Column",
                                    "width": "${percentValueClamped}",
                                    "items": [],
                                    "minHeight": "4px",
                                    "style": "accent"
                                },
                                {
                                    "type": "Column",
                                    "width": "${percentRemaining}",
                                    "items": [],
                                    "minHeight": "4px",
                                    "style": "emphasis"
                                }
                            ]
                        },
                        {
                            "type": "ColumnSet",
                            "$when": "${barStyle == 'warning'}",
                            "spacing": "none",
                            "columns": [
                                {
                                    "type": "Column",
                                    "width": "${percentValueClamped}",
                                    "items": [],
                                    "minHeight": "4px",
                                    "style": "warning"
                                },
                                {
                                    "type": "Column",
                                    "width": "${percentRemaining}",
                                    "items": [],
                                    "minHeight": "4px",
                                    "style": "emphasis"
                                }
                            ]
                        },
                        {
                            "type": "ColumnSet",
                            "$when": "${barStyle == 'attention'}",
                            "spacing": "none",
                            "columns": [
                                {
                                    "type": "Column",
                                    "width": "${percentValueClamped}",
                                    "items": [],
                                    "minHeight": "4px",
                                    "style": "attention"
                                },
                                {
                                    "type": "Column",
                                    "width": "${percentRemaining}",
                                    "items": [],
                                    "minHeight": "4px",
                                    "style": "emphasis"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Column",
                    "width": "auto",
                    "verticalContentAlignment": "center",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "${percentText} used",
                            "size": "small",
                            "color": "${statusColor}"
                        }
                    ]
                }
            ]
        },
        {
            "type": "ColumnSet",
            "spacing": "medium",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "Weekly · all models",
                            "weight": "bolder",
                            "size": "default",
                            "isSubtle": false
                        }
                    ]
                },
                {
                    "type": "Column",
                    "width": "auto",
                    "verticalContentAlignment": "bottom",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "${sevenDayReset}",
                            "size": "small",
                            "isSubtle": true
                        }
                    ]
                }
            ]
        },
        {
            "type": "ColumnSet",
            "spacing": "small",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "verticalContentAlignment": "center",
                    "items": [
                        {
                            "type": "ColumnSet",
                            "$when": "${sevenDayBarStyle == 'accent'}",
                            "spacing": "none",
                            "columns": [
                                {
                                    "type": "Column",
                                    "width": "${sevenDayValueClamped}",
                                    "items": [],
                                    "minHeight": "4px",
                                    "style": "accent"
                                },
                                {
                                    "type": "Column",
                                    "width": "${sevenDayRemaining}",
                                    "items": [],
                                    "minHeight": "4px",
                                    "style": "emphasis"
                                }
                            ]
                        },
                        {
                            "type": "ColumnSet",
                            "$when": "${sevenDayBarStyle == 'warning'}",
                            "spacing": "none",
                            "columns": [
                                {
                                    "type": "Column",
                                    "width": "${sevenDayValueClamped}",
                                    "items": [],
                                    "minHeight": "4px",
                                    "style": "warning"
                                },
                                {
                                    "type": "Column",
                                    "width": "${sevenDayRemaining}",
                                    "items": [],
                                    "minHeight": "4px",
                                    "style": "emphasis"
                                }
                            ]
                        },
                        {
                            "type": "ColumnSet",
                            "$when": "${sevenDayBarStyle == 'attention'}",
                            "spacing": "none",
                            "columns": [
                                {
                                    "type": "Column",
                                    "width": "${sevenDayValueClamped}",
                                    "items": [],
                                    "minHeight": "4px",
                                    "style": "attention"
                                },
                                {
                                    "type": "Column",
                                    "width": "${sevenDayRemaining}",
                                    "items": [],
                                    "minHeight": "4px",
                                    "style": "emphasis"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Column",
                    "width": "auto",
                    "verticalContentAlignment": "center",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "${sevenDayPercent} used",
                            "size": "small",
                            "color": "${sevenDayStatusColor}"
                        }
                    ]
                }
            ]
        },
        {
            "type": "Container",
            "$when": "${scopedLabel != ''}",
            "spacing": "small",
            "items": [
                {
                    "type": "TextBlock",
                    "text": "${scopedLabel} only",
                    "size": "small",
                    "isSubtle": true
                },
                {
                    "type": "ColumnSet",
                    "spacing": "none",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "stretch",
                            "verticalContentAlignment": "center",
                            "items": [
                                {
                                    "type": "ColumnSet",
                                    "$when": "${scopedBarStyle == 'accent'}",
                                    "spacing": "none",
                                    "columns": [
                                        {
                                            "type": "Column",
                                            "width": "${scopedValueClamped}",
                                            "items": [],
                                            "minHeight": "4px",
                                            "style": "accent"
                                        },
                                        {
                                            "type": "Column",
                                            "width": "${scopedRemaining}",
                                            "items": [],
                                            "minHeight": "4px",
                                            "style": "emphasis"
                                        }
                                    ]
                                },
                                {
                                    "type": "ColumnSet",
                                    "$when": "${scopedBarStyle == 'warning'}",
                                    "spacing": "none",
                                    "columns": [
                                        {
                                            "type": "Column",
                                            "width": "${scopedValueClamped}",
                                            "items": [],
                                            "minHeight": "4px",
                                            "style": "warning"
                                        },
                                        {
                                            "type": "Column",
                                            "width": "${scopedRemaining}",
                                            "items": [],
                                            "minHeight": "4px",
                                            "style": "emphasis"
                                        }
                                    ]
                                },
                                {
                                    "type": "ColumnSet",
                                    "$when": "${scopedBarStyle == 'attention'}",
                                    "spacing": "none",
                                    "columns": [
                                        {
                                            "type": "Column",
                                            "width": "${scopedValueClamped}",
                                            "items": [],
                                            "minHeight": "4px",
                                            "style": "attention"
                                        },
                                        {
                                            "type": "Column",
                                            "width": "${scopedRemaining}",
                                            "items": [],
                                            "minHeight": "4px",
                                            "style": "emphasis"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "Column",
                            "width": "auto",
                            "verticalContentAlignment": "center",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "${scopedPercent} used",
                                    "size": "small",
                                    "color": "${scopedStatusColor}"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "ColumnSet",
            "spacing": "small",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "${breakdown}",
                            "size": "small",
                            "isSubtle": true,
                            "wrap": true
                        }
                    ]
                },
                {
                    "type": "Column",
                    "width": "auto",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "${creditsText}",
                            "size": "small",
                            "isSubtle": true
                        }
                    ]
                }
            ]
        },
        {
            "type": "TextBlock",
            "text": "This session",
            "weight": "bolder",
            "spacing": "large"
        },
        {
            "type": "TextBlock",
            "text": "${sessionLine}",
            "size": "small",
            "isSubtle": true,
            "wrap": true,
            "maxLines": 2,
            "spacing": "none"
        },
        {
            "type": "ColumnSet",
            "$when": "${liveFlag != ''}",
            "spacing": "small",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "Input",
                            "size": "small",
                            "isSubtle": true
                        },
                        {
                            "type": "TextBlock",
                            "text": "${inputTokens}",
                            "spacing": "none"
                        }
                    ]
                },
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "Output",
                            "size": "small",
                            "isSubtle": true
                        },
                        {
                            "type": "TextBlock",
                            "text": "${outputTokens}",
                            "spacing": "none"
                        }
                    ]
                },
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "Cache W",
                            "size": "small",
                            "isSubtle": true
                        },
                        {
                            "type": "TextBlock",
                            "text": "${cacheCreation}",
                            "spacing": "none"
                        }
                    ]
                },
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "Cache R",
                            "size": "small",
                            "isSubtle": true
                        },
                        {
                            "type": "TextBlock",
                            "text": "${cacheRead}",
                            "spacing": "none"
                        }
                    ]
                }
            ]
        }
    ],
    "backgroundImage": {
        "url": "data:image/png;base64,",
        "fillMode": "repeatVertically"
    }
}